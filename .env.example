# Copy to .env. Never commit the filled-in version.

ENVIRONMENT=development
DEBUG=true

# --- Database -----------------------------------------------------------
# Must be the asyncpg driver. A postgresql:// URL silently pulls in the sync
# driver and every request blocks the event loop.
DATABASE_URL=postgresql+asyncpg://als:als@localhost:5432/als

# Behind a transaction-mode pooler (PgBouncer, Supabase pooler), prepared
# statements have to be off or asyncpg errors on the second identical query.
DATABASE_USE_PGBOUNCER=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Auth ---------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=change-me-in-every-environment
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=60

# --- Admin console ------------------------------------------------------
# Admins have their own token type, signed with JWT_SECRET above but rejected
# by the student endpoints and vice versa. Shorter lived than a student's: a
# console left open on a laptop is a different risk from an app on a locked
# phone.
#
# There is no seeded admin and no sign-up. Create the first one at a shell:
#
#     python scripts/create_admin.py --email you@ardena.co.ke --role owner
ADMIN_ACCESS_TTL_MINUTES=60
ADMIN_REFRESH_TTL_DAYS=7

# --- Supabase Storage ---------------------------------------------------
# The service role key bypasses row-level security. It lives on the server and
# never anywhere near the app bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_SIGNED_URL_TTL=3600

# --- SMS (Celcom Africa) ------------------------------------------------
# Leave blank in development: codes are written to the server log instead of
# being sent, so the whole signup flow is testable with no account.
SMS_API_KEY=
SMS_PARTNER_ID=
SMS_SENDER_ID=

# --- Google sign-in -----------------------------------------------------
# Comma-separated OAuth client ids from the Google console — the iOS, Android
# and web ones. An ID token is rejected unless its audience is in this list.
GOOGLE_CLIENT_IDS=

# --- OTP ----------------------------------------------------------------
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# --- Payments -----------------------------------------------------------
# Kora — https://korahq.com. Both keys come from the dashboard; the secret one
# never leaves the server.
#
# Two things differ from the Paystack integration this replaced, and both are
# silent when wrong. Kora charges in the MAJOR unit (350 means KES 350), and it
# signs webhooks over only the `data` object with SHA-256. See
# app/services/kora.py — neither needs configuring, but both are worth knowing
# before anyone "fixes" one of them.
KORA_SECRET_KEY=
KORA_PUBLIC_KEY=

# Kora signs webhooks with the secret key itself; there is no separate webhook
# secret in the dashboard. Leave this blank unless that changes.
KORA_WEBHOOK_SECRET=

# Where Kora sends the browser after a payment. Blank uses the dashboard
# setting, which is fine — the app verifies the reference it was handed when
# the browser closes. Set it to als://billing to have the payment page bounce
# straight back into the app.
KORA_CALLBACK_URL=

# Domain for the stand-in address used when an account has no email, which is
# every phone sign-in. Never receives mail.
RECEIPT_EMAIL_DOMAIN=als.ardena.xyz

# --- This service's own address ------------------------------------------
# Public origin, no trailing slash. Kora is told to post webhooks to
# {PUBLIC_BASE_URL}/api/v1/billing/webhook when a charge is opened.
#
# It cannot be derived from the request: behind nginx the app only ever sees
# 127.0.0.1:8000. Setting it per environment is also what stops a staging
# deploy from registering itself for production's webhooks.
PUBLIC_BASE_URL=https://als.ardena.xyz

# --- Outbound -----------------------------------------------------------
HTTP_TIMEOUT_SECONDS=15

# --- CORS ---------------------------------------------------------------
# The mobile app does not need CORS; this is for the docs and any web client.
# The admin console *is* a web client, so its origin has to be listed here or
# every request from it fails in the browser before it reaches this service.
CORS_ORIGINS=http://localhost:5173,https://admin.ardena.xyz
