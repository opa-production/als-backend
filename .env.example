# ALS backend — environment
#
# Copy to `.env` and fill in. Never commit the filled-in version.
#
# Ordered by what you have to do, not by what the code does:
#
#   PART 1  Must be set, or the service refuses to start in production.
#   PART 2  Set these, or a feature is unavailable. The service still runs and
#           the missing pieces report themselves — PART 5 says what breaks.
#   PART 3  Sensible defaults. Change only with a reason.
#
# The rule behind that split: this service refuses to boot when serving would be
# *unsafe for everyone* (a forgeable signing secret), and degrades when a single
# *feature* is missing. A blank Kora key must not take down someone's notes.
# The two lists live in `app/core/config.py`.


# ==============================================================================
# PART 1 — Required
# ==============================================================================

# development | production
#
# `production` turns off /docs and /openapi.json, and turns on the startup
# checks. Leaving a live deployment on `development` publishes the entire API
# surface — including every /admin route — to anyone who asks for it.
ENVIRONMENT=production

# Never true in production. It puts internal detail into error responses.
DEBUG=false

# The signing key for every token this service issues — students and admins
# alike. If it is guessable, anyone can mint a token for any account, including
# an owner-level admin one. The service refuses to start in production while
# this is still the default.
#
#   openssl rand -hex 32
JWT_SECRET=

# Postgres, on the asyncpg driver.
#
# The `+asyncpg` is not optional. A bare `postgresql://` URL silently loads the
# *sync* driver and every query then blocks the event loop — the service does
# not fail, it just gets mysteriously slow under load. Hosted providers hand out
# the bare form, so it is rewritten automatically where that is unambiguous; a
# URL naming some other driver is refused outright.
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/als

# This service's own public origin, no trailing slash.
#
# Every Kora charge is opened with a webhook address built from this. It cannot
# be derived from an inbound request — behind nginx the app only ever sees
# 127.0.0.1:8000 — and setting it per environment is what stops a staging
# deploy from registering itself for production's webhooks.
PUBLIC_BASE_URL=https://als.ardena.xyz

# Origins allowed to call this API from a browser, comma separated.
#
# The mobile app does not need this; the admin console does. Miss its origin and
# every request from it fails in the browser before reaching this service, which
# looks exactly like the API being down.
#
# Scheme and host exactly, no trailing slash and no path -- an origin is only
# those two parts, and https://als.admin.ardena.co.ke/ with the slash does not
# match https://als.admin.ardena.co.ke.
CORS_ORIGINS=https://als.admin.ardena.co.ke,http://localhost:5173


# ==============================================================================
# PART 2 — Integrations
#
# Each is independent. Blank means that one feature reports itself unavailable
# and everything else carries on.
# ==============================================================================

# --- Payments: Kora (https://korahq.com) --------------------------------------
#
# Two things differ from Paystack, and both are silent when wrong:
#   · Kora charges the MAJOR unit — 350 means KES 350, not 3.50.
#   · Kora signs webhooks over only the `data` object, with SHA-256.
# Neither needs configuring here. Both are worth knowing before anyone "fixes"
# one of them. See app/services/kora.py.
KORA_SECRET_KEY=
KORA_PUBLIC_KEY=

# Leave blank. Kora signs webhooks with the secret key above — there is no
# separate webhook secret in the dashboard. Set this only to pin a different
# value if that ever changes.
KORA_WEBHOOK_SECRET=

# Where Kora sends the browser after a payment. Blank uses the dashboard's own
# setting, which is fine — the app verifies the reference it was handed when the
# browser closes. `als://billing` bounces straight back into the app.
KORA_CALLBACK_URL=

# --- Files: Supabase Storage --------------------------------------------------
#
# The service role key bypasses row-level security. It lives here and never
# anywhere near the app bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=

# --- Sign-in codes: Celcom Africa ---------------------------------------------
#
# Blank means codes are written to the server log instead of sent — the right
# behaviour locally, and useless in production.
SMS_API_KEY=
SMS_PARTNER_ID=
# The sender name shown on the handset.
SMS_SENDER_ID=

# --- Push notifications: Expo -------------------------------------------------
#
# Expo accepts a send with no credential at all, so a key would be a useless
# switch: there would be nothing to leave unset locally, and every test run
# would fire real notifications at whatever tokens the database held. Off means
# the reminder sweep still runs and still decides what to send — it writes the
# notification to the log instead of the handset.
PUSH_ENABLED=false
# Only needed once the Expo project turns on enhanced security.
EXPO_ACCESS_TOKEN=
# How long Expo may keep retrying. Short on purpose: a class reminder is
# worthless an hour late.
PUSH_TTL_SECONDS=1800
# How often the worker looks for reminders coming due. Also the granularity of
# a reminder — a 15-minute lead lands in the minute before, never earlier.
REMINDER_SWEEP_SECONDS=60

# --- The store review account -------------------------------------------------
#
# Google Play and the App Store ask for a working login in the review notes,
# and there is no password to give them: sign-in is Google or a code texted to
# a phone the reviewer does not hold.
#
# Setting both of these declares one number as a review account. Asking for a
# code on it sends no SMS and writes nothing to the database — the code below
# is the only one it ever accepts — and signing in with it puts the account on
# a full Synapse plan that is renewed on every sign-in, so a reviewer months
# from now still does not meet the paywall.
#
# Leave both blank anywhere that does not face a reviewer. Two rules for the
# number: it must be one no real person can ever be issued, or a student would
# be handed a number that signs in without a code; and the code should be long
# enough that nobody guesses it by trying the number they read in a store
# listing. Both must be given, or the account does not exist.
REVIEW_PHONE=
REVIEW_OTP_CODE=

# --- The tutor ----------------------------------------------------------
#
# One key per provider. A provider with no key is still *listed* by
# /tutor/models and reported unavailable, so the app's model picker shows the
# whole line-up with the ones you cannot pick yet greyed out.
#
# DeepSeek is the one that works today. OpenAI needs only a key — it speaks the
# same wire format, so the adapter is already written. Claude and Gemini need
# their adapters writing first; /tutor/models says which of the two problems a
# given model has.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# What a student gets when they express no preference.
AI_DEFAULT_MODEL=deepseek-chat

# Reading a photograph of a page (the Synapse scan feature).
#
# Needs a model with vision, whatever the tutor is set to — DeepSeek cannot see.
# Gemini by default: cheapest per image of the things that read handwriting
# well, and the free tier covers a small cohort outright. Get a key from Google
# AI Studio and put it in GOOGLE_API_KEY above.
#
# OCR_BASE_URL is any endpoint speaking the OpenAI /chat/completions shape, so
# switching provider is these two lines and not a code change:
#
#   OpenRouter  https://openrouter.ai/api/v1          + OCR_API_KEY
#   OpenAI      https://api.openai.com/v1             + OCR_API_KEY
#   Groq        https://api.groq.com/openai/v1        + OCR_API_KEY
#
# OCR_API_KEY is only needed when you point OCR_BASE_URL somewhere other than
# Google; left blank it falls back to GOOGLE_API_KEY.
#
# With no key at all the worker leaves scans `pending` rather than failing them,
# so setting one later reads everything that has been waiting.
OCR_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
OCR_MODEL=gemini-2.5-flash
OCR_API_KEY=

# Long enough for a full explanation, short enough that a runaway generation
# cannot bill for a novel.
AI_MAX_OUTPUT_TOKENS=900

# Low, not zero. Coursework answers should be steady rather than inventive, but
# zero makes a model repeat itself almost word for word when a student
# rephrases the same question.
AI_TEMPERATURE=0.3

# Separate from HTTP_TIMEOUT_SECONDS, which is 15s and right for Kora and
# Supabase. A model streaming 900 tokens routinely takes longer than that, and
# cutting it off at 15s looks like the tutor failing at random.
AI_TIMEOUT_SECONDS=120

# How many passages go into the prompt. Past about six the useful ones get lost
# among the rest and the answer starts drifting.
AI_RETRIEVAL_TOP_K=6

# Below this score, the student's own material is treated as not containing the
# answer and the tutor says so before answering from general knowledge. The
# whole "I could not find this in your notes" behaviour turns on this number.
AI_RETRIEVAL_MIN_SCORE=0.04

# --- Google sign-in -----------------------------------------------------------
#
# The OAuth client ids the mobile app uses, comma separated. An ID token is only
# accepted if its audience is one of these — without the check, a token minted
# for any other Google app would authenticate here.
GOOGLE_CLIENT_IDS=


# ==============================================================================
# PART 3 — Defaults
#
# Everything below already works. Listed so nothing is hidden.
# ==============================================================================

# --- Database pool ------------------------------------------------------------
# Behind a transaction-mode pooler (PgBouncer, Supabase's), prepared statements
# must be off or asyncpg fails on the second identical query — under load only,
# and never in development.
DATABASE_USE_PGBOUNCER=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20
# Logs every statement. Useful for an afternoon, ruinous left on.
DATABASE_ECHO=false

# --- Tokens -------------------------------------------------------------------
JWT_ALGORITHM=HS256
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=60

# Admin sessions are shorter than a student's: a console left open on a laptop
# is a different risk from an app on a phone that is already locked.
ADMIN_ACCESS_TTL_MINUTES=60
ADMIN_REFRESH_TTL_DAYS=7

# --- One-time codes -----------------------------------------------------------
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
# Codes per number per hour. An unthrottled send endpoint is a bill someone else
# can run up.
OTP_MAX_SENDS_PER_HOUR=5

# --- Storage ------------------------------------------------------------------
# How long a signed URL lasts. Short on purpose: a link pasted into a group chat
# should stop working long before it spreads.
SUPABASE_STORAGE_SIGNED_URL_TTL=3600

# --- Payments -----------------------------------------------------------------
# Domain for the stand-in address used when an account has no email, which is
# every phone sign-in. Kora requires a customer email; this one never receives
# mail, and `metadata.user_id` is what actually ties a payment to a student.
RECEIPT_EMAIL_DOMAIN=als.ardena.xyz

# --- Outbound -----------------------------------------------------------------
# Every outbound call gets a deadline. A hung upstream must fail in seconds
# rather than hold a worker until the container is killed.
HTTP_TIMEOUT_SECONDS=15


# ==============================================================================
# PART 4 — The admin console
#
# Not configured here. It is a separate front end with its own repository and
# its own .env; the only thing it needs from this file is its origin appearing
# in CORS_ORIGINS above.
#
# The first administrator is created at a shell, once, with the database
# reachable:
#
#   python scripts/create_admin.py --email you@ardena.co.ke --role owner
#
# There is deliberately no sign-up and no seeded account. A console that can
# create its own first account is one that anyone who finds the URL can create
# an account on.
# ==============================================================================


# ==============================================================================
# PART 5 — What breaks when a PART 2 value is blank
#
#   KORA_SECRET_KEY      /billing/checkout and /billing/verify refuse. Existing
#                        subscriptions are unaffected.
#   PUBLIC_BASE_URL      Charges carry no webhook address, so payments succeed
#                        at Kora and are never credited here. Reconcile by hand
#                        from the console's Payments page.
#   SUPABASE_*           /materials upload and download refuse. Notes typed in
#                        the app still sync — only files are affected.
#   SMS_*                Sign-in codes go to the server log. Nobody can sign in
#                        who is not reading it.
#   REVIEW_PHONE/        The store review number does not exist, and the login
#   REVIEW_OTP_CODE      in the Play Console review notes stops working.
#   GOOGLE_CLIENT_IDS    /auth/google refuses. Phone sign-in still works.
#   DEEPSEEK_API_KEY     /tutor/ask and /tutor/quiz refuse and the app's tutor
#                        is unavailable. Notes, timetable and sync are fine.
#   GOOGLE_API_KEY       Photographs of notes are never read. They are left
#                        `pending` rather than failed, so setting the key later
#                        picks up everything that has been waiting. PDFs are
#                        unaffected. (Or OCR_API_KEY, if OCR_BASE_URL points
#                        somewhere other than Google.)
#
# One thing that is not a key. The extraction worker (`als-worker`) is what
# turns an uploaded PDF into the text the tutor quotes. With Supabase set but
# the worker not running, uploads succeed, sit at `pending` forever, and every
# coursework question is answered "I could not find this in your material" —
# which looks like the tutor being broken. The console's Operations page shows
# the queue depth, and `systemctl status als-worker` shows whether it is alive.
#
# All of these are logged as `feature_unavailable` at startup and shown on the
# console's Operations page. `GET /ready` reports whether this process can serve
# at all, which means the database and nothing else.
# ==============================================================================
