# Copy to .env. Never commit the filled-in version.

ENVIRONMENT=development
DEBUG=true

# --- Database -----------------------------------------------------------
# Must be the asyncpg driver. A postgresql:// URL silently pulls in the sync
# driver and every request blocks the event loop.
DATABASE_URL=postgresql+asyncpg://als:als@localhost:5432/als

# Behind a transaction-mode pooler (PgBouncer, Supabase pooler), prepared
# statements have to be off or asyncpg errors on the second identical query.
DATABASE_USE_PGBOUNCER=false
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# --- Auth ---------------------------------------------------------------
# openssl rand -hex 32
JWT_SECRET=change-me-in-every-environment
JWT_ACCESS_TTL_MINUTES=30
JWT_REFRESH_TTL_DAYS=60

# --- Supabase Storage ---------------------------------------------------
# The service role key bypasses row-level security. It lives on the server and
# never anywhere near the app bundle.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=
SUPABASE_STORAGE_SIGNED_URL_TTL=3600

# --- SMS (Celcom Africa) ------------------------------------------------
# Leave blank in development: codes are written to the server log instead of
# being sent, so the whole signup flow is testable with no account.
SMS_API_KEY=
SMS_PARTNER_ID=
SMS_SENDER_ID=

# --- Google sign-in -----------------------------------------------------
# Comma-separated OAuth client ids from the Google console — the iOS, Android
# and web ones. An ID token is rejected unless its audience is in this list.
GOOGLE_CLIENT_IDS=

# --- OTP ----------------------------------------------------------------
OTP_TTL_SECONDS=600
OTP_MAX_ATTEMPTS=5
OTP_MAX_SENDS_PER_HOUR=5

# --- Payments -----------------------------------------------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_WEBHOOK_SECRET=
# Where Paystack sends the browser after a successful payment. Blank uses
# the dashboard setting, which is fine — the app verifies the reference it
# was handed when the browser closes. Set it to als://billing to have the
# payment page bounce straight back into the app.
PAYSTACK_CALLBACK_URL=
# Domain for the stand-in address used when an account has no email, which
# is every phone sign-in. Never receives mail.
RECEIPT_EMAIL_DOMAIN=als.ardena.co.ke

# --- Outbound -----------------------------------------------------------
HTTP_TIMEOUT_SECONDS=15

# --- CORS ---------------------------------------------------------------
# The mobile app does not need CORS; this is for the docs and any web client.
CORS_ORIGINS=http://localhost:8081,http://localhost:19006
