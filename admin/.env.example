# Copy to `.env.local`. Vite reads it at start, so restart after changing it.
#
# Only `VITE_`-prefixed variables reach the browser, and everything here is
# inlined into the bundle at build time. Nothing secret belongs in this file —
# the admin console holds no credentials of its own; it authenticates with a
# token the API issues at sign-in.

# The API origin, no trailing slash and no /api/v1 — the version prefix lives
# in src/lib/api.js.
VITE_API_URL=https://als.ardena.xyz

# `true` (or unset) serves the seeded fixture in src/lib/mock/ and never touches
# the network. That is the default so `npm run dev` works with no backend
# running, and so the design can be worked on against stable numbers.
#
# Set to `false` to talk to VITE_API_URL for real. The console's own origin must
# also appear in the API's CORS_ORIGINS, or every request fails in the browser
# before it reaches the service.
VITE_USE_MOCKS=true
