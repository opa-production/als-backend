# systemd unit for the ALS extraction worker.
#
# Installed by hand — see DEPLOYMENT.md section 2. Edit it here, copy it to
# /etc/systemd/system/, then `systemctl daemon-reload`.
#
# A separate process from the API, deliberately: PDF parsing is CPU-bound, and
# a handler that blocks the event loop stalls every other request on that
# process. See ARCHITECTURE.md §3.

[Unit]
Description=ALS extraction worker
After=network-online.target
Wants=network-online.target
# Not Requires=: the worker is useful on its own and the API is useful without
# it. Tying them together would mean restarting one bounces the other.
After=als-backend.service

[Service]
Type=exec
User=als
Group=als
WorkingDirectory=/opt/als-backend

# The same secrets file as the API. It needs the database and Supabase; it
# never touches Kora or the AI keys.
EnvironmentFile=/etc/als-backend/env
# ProtectHome=true below makes /home unreadable, and asyncpg reacts badly to
# that. Whenever TLS is in play it computes a default client-key path of
# $HOME/.postgresql/postgresql.key and calls .exists() on it -- which raises
# PermissionError rather than returning False, so the connection dies before a
# socket is ever opened. The symptom is maddening: the service reports the
# database unreachable in ~100ms while the identical URL connects fine from a
# shell, because a shell is not sandboxed.
#
# Pointing HOME at the app directory fixes it without weakening the sandbox:
# the path is stattable, .postgresql simply is not there, and .exists() answers
# False the way asyncpg expects. Do not "fix" this by relaxing ProtectHome.
Environment=HOME=/opt/als-backend


ExecStart=/opt/als-backend/.venv/bin/python -m app.workers.runner

# The worker checks for shutdown between documents, so a clean stop takes at
# most one document's parse. Ninety seconds is generous for the largest file
# the plans allow.
KillSignal=SIGTERM
TimeoutStopSec=90

Restart=always
RestartSec=5

# One CPU-bound process should not be able to starve the API on a small box.
# A soft cap rather than a hard one: it slows the worker down under contention
# instead of killing it mid-document.
CPUWeight=50
MemoryMax=512M

# Hardening, matching the API's. The worker needs its own directory and the
# network and nothing else.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictNamespaces=true
LockPersonality=true
ReadWritePaths=/opt/als-backend

StandardOutput=journal
StandardError=journal
SyslogIdentifier=als-worker

[Install]
WantedBy=multi-user.target
